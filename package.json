{
  "name": "bela-hrms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:up": "node scripts/dev/up.mjs",
    "dev:doctor": "node scripts/dev/doctor.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:fresh": "node scripts/dev/db.mjs fresh",
    "db:status": "node scripts/dev/db.mjs status",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "db:seed:history": "tsx --conditions=react-server --env-file=.env src/db/seed-history.ts",
    "db:reset": "tsx --env-file=.env src/db/seed.ts --reset",
    "admin:unlock": "tsx --conditions=react-server --env-file=.env scripts/admin-unlock.ts",
    "check:attendance": "tsx --conditions=react-server --env-file=.env scripts/check-attendance-flow.ts",
    "check:isolation": "tsx --conditions=react-server --env-file=.env scripts/check-module-isolation.ts",
    "check:leave": "tsx --conditions=react-server --env-file=.env scripts/check-leave-effects.ts",
    "check:org": "tsx --conditions=react-server --env-file=.env scripts/check-org-structure.ts",
    "check:pagination": "tsx --env-file=.env scripts/check-pagination.ts",
    "check:self": "tsx --conditions=react-server --env-file=.env scripts/check-self-service.ts"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.2.4",
    "better-auth": "^1.7.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.34.5"
}
