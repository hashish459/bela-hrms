# ---------------------------------------------------------------- Bela-HRMS
#
# Copy to .env for local development, or to /opt/bela-hrms/.env on the server.
# Never commit the filled-in file: it holds the database password and the key
# that signs every session cookie.

# --------------------------------------------------------------- database
#
# The database MUST be UTF-8. A Windows PostgreSQL install defaults its
# templates to WIN1252, which cannot store Devanagari and fails on the first
# Nepali-script insert:
#
#   CREATE DATABASE bela_hrms ENCODING 'UTF8' LC_COLLATE 'C' LC_CTYPE 'C' TEMPLATE template0;
#
# In Docker Compose the host is the service name, not localhost.
DATABASE_URL=postgres://bela:change-me@localhost:5432/bela_hrms

# ------------------------------------------------------------------- auth
#
# Signs session cookies. Generate a fresh one per environment:
#
#   openssl rand -base64 48
#
# Changing it signs everybody out; leaking it lets anybody forge a session.
BETTER_AUTH_SECRET=

# The public origin, exactly as a browser sees it — scheme, host, no trailing
# slash. Behind a reverse proxy this is the *public* URL, not the container's.
# Getting it wrong breaks sign-in with a cookie the browser silently drops.
BETTER_AUTH_URL=http://localhost:3000

# ------------------------------------------------------------- deployment
#
# Used by docker-compose. POSTGRES_PASSWORD must match the password in
# DATABASE_URL above.
POSTGRES_USER=bela
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bela_hrms

# The hostname Caddy obtains a certificate for. Point its DNS A record at this
# VPS before starting the stack, or the certificate request fails and Caddy
# backs off for an hour.
APP_DOMAIN=hrms.example.com

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=it@example.com

# ---------------------------------------------------------- notifications
#
# Email transport: webhook | log | none. Unset means "log" in development and
# "none" in production. The webhook receives POST {to, from, subject, text}.
NOTIFY_EMAIL_TRANSPORT=
NOTIFY_EMAIL_WEBHOOK_URL=
NOTIFY_EMAIL_WEBHOOK_TOKEN=
NOTIFY_EMAIL_FROM=hrms@example.com

# Enables POST /api/cron/notifications with "Authorization: Bearer <secret>".
# Leave empty to disable the endpoint (it then answers 404).
CRON_SECRET=

# ---------------------------------------------------------------- database pool
#
# Optional. Defaults shown. The statement timeout stops one runaway report from
# holding a connection and its locks while every other request queues.
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_CONNECT_TIMEOUT_MS=10000
